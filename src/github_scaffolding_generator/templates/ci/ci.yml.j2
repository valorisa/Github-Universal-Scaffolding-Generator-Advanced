name: CI
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
{% if "lint" in ci_targets %}
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
{% if "Python" in stack %}
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install ruff poetry && poetry install
      - run: ruff check .
{% elif "Node" in stack %}
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - run: npm install -g pnpm && pnpm install
      - run: pnpm lint
{% elif "Go" in stack %}
      - uses: actions/setup-go@v5
        with:
          go-version: '1.22'
      - run: go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest
      - run: golangci-lint run
{% elif "Java" in stack %}
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
      - run: mvn checkstyle:check
{% elif "Rust" in stack %}
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: clippy
      - run: cargo clippy -- -D warnings
{% endif %}
{% endif %}
{% if "test" in ci_targets %}
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
{% if "Python" in stack %}
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install pytest poetry && poetry install
      - run: pytest tests/
{% elif "Node" in stack %}
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - run: npm install -g pnpm && pnpm install
      - run: pnpm test
{% elif "Go" in stack %}
      - uses: actions/setup-go@v5
        with:
          go-version: '1.22'
      - run: go test ./...
{% elif "Java" in stack %}
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
      - run: mvn test
{% elif "Rust" in stack %}
      - uses: dtolnay/rust-toolchain@stable
      - run: cargo test
{% endif %}
{% endif %}
{% if "build" in ci_targets %}
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
{% if "Python" in stack %}
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install poetry && poetry install
      - run: poetry build
{% elif "Node" in stack %}
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - run: npm install -g pnpm && pnpm install
      - run: pnpm build
{% elif "Go" in stack %}
      - uses: actions/setup-go@v5
        with:
          go-version: '1.22'
      - run: go build ./...
{% elif "Java" in stack %}
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
      - run: mvn package -DskipTests
{% elif "Rust" in stack %}
      - uses: dtolnay/rust-toolchain@stable
      - run: cargo build --release
{% endif %}
{% endif %}
{% if "release" in ci_targets %}
  release:
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'
    needs: [{% if "lint" in ci_targets %}lint, {% endif %}{% if "test" in ci_targets %}test, {% endif %}{% if "build" in ci_targets %}build{% endif %}]
    steps:
      - uses: actions/checkout@v4
{% if "Python" in stack %}
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install poetry
      - run: poetry publish --build
        env:
          POETRY_PYPI_TOKEN_PYPI: ${{ "${{ secrets.PYPI_TOKEN }}" }}
{% elif "Node" in stack %}
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          registry-url: 'https://registry.npmjs.org'
      - run: npm install -g pnpm && pnpm install && pnpm build
      - run: pnpm publish --no-git-checks
        env:
          NODE_AUTH_TOKEN: ${{ "${{ secrets.NPM_TOKEN }}" }}
{% elif "Go" in stack %}
      - uses: actions/setup-go@v5
        with:
          go-version: '1.22'
      - uses: goreleaser/goreleaser-action@v5
        with:
          args: release --clean
        env:
          GITHUB_TOKEN: ${{ "${{ secrets.GITHUB_TOKEN }}" }}
{% elif "Java" in stack %}
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
      - run: mvn deploy
        env:
          MAVEN_USERNAME: ${{ "${{ secrets.MAVEN_USERNAME }}" }}
          MAVEN_PASSWORD: ${{ "${{ secrets.MAVEN_PASSWORD }}" }}
{% elif "Rust" in stack %}
      - uses: dtolnay/rust-toolchain@stable
      - run: cargo publish
        env:
          CARGO_REGISTRY_TOKEN: ${{ "${{ secrets.CARGO_TOKEN }}" }}
{% endif %}
{% endif %}
