#!/usr/bin/env bash
set -euo pipefail

# {{ project_name }}
# {{ description }}
#
# Author: {{ author }}
# License: {{ license }}
# Generated by GitHub Universal Scaffolding Generator

# Color output helpers
readonly COLOR_RED='\033[0;31m'
readonly COLOR_GREEN='\033[0;32m'
readonly COLOR_YELLOW='\033[1;33m'
readonly COLOR_BLUE='\033[0;34m'
readonly COLOR_RESET='\033[0m'

# Script metadata
readonly SCRIPT_NAME="{{ project_name }}"
readonly SCRIPT_VERSION="0.1.0"
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Logging functions
log_info() {
    echo -e "${COLOR_BLUE}[INFO]${COLOR_RESET} $*"
}

log_success() {
    echo -e "${COLOR_GREEN}[SUCCESS]${COLOR_RESET} $*"
}

log_warning() {
    echo -e "${COLOR_YELLOW}[WARNING]${COLOR_RESET} $*"
}

log_error() {
    echo -e "${COLOR_RED}[ERROR]${COLOR_RESET} $*" >&2
}

# Show usage information
show_usage() {
    cat <<EOF
Usage: ${SCRIPT_NAME} [OPTIONS] <command>

{{ description }}

Commands:
    hello <name>    Print a greeting message
    version         Show version information
    help            Show this help message

Options:
    -v, --verbose   Enable verbose output
    -q, --quiet     Suppress non-error output
    -h, --help      Show this help message

Examples:
    ${SCRIPT_NAME} hello World
    ${SCRIPT_NAME} --verbose hello PowerUser
    ${SCRIPT_NAME} version

EOF
}

# Show version information
show_version() {
    echo "${SCRIPT_NAME} version ${SCRIPT_VERSION}"
    echo "Author: {{ author }}"
    echo "License: {{ license }}"
}

# Main command: hello
cmd_hello() {
    local name="${1:-World}"
    log_info "Executing hello command..."
    log_success "Hello, ${name}!"
}

# Parse command-line arguments
parse_args() {
    local verbose=0
    local quiet=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -v|--verbose)
                verbose=1
                shift
                ;;
            -q|--quiet)
                quiet=1
                shift
                ;;
            -h|--help|help)
                show_usage
                exit 0
                ;;
            version)
                show_version
                exit 0
                ;;
            hello)
                shift
                cmd_hello "$@"
                exit 0
                ;;
            *)
                log_error "Unknown command or option: $1"
                show_usage
                exit 1
                ;;
        esac
    done

    # No command provided
    log_error "No command specified"
    show_usage
    exit 1
}

# Main entry point
main() {
    if [[ $# -eq 0 ]]; then
        show_usage
        exit 0
    fi

    parse_args "$@"
}

# Run main function
main "$@"
