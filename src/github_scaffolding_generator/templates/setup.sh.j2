#!/usr/bin/env bash
set -euo pipefail

# Setup script for {{ project_name }}
# Generated by GitHub Universal Scaffolding Generator
#
# Prerequisites:
#   gh auth login   (one-time GitHub authentication)
#
# Usage:
#   chmod +x setup.sh
#   ./setup.sh

PROJECT_NAME="{{ project_name }}"
AUTHOR="{{ author }}"
VISIBILITY="{{ visibility }}"
DESCRIPTION="{{ description }}"

echo ""
echo "=== Setup: ${PROJECT_NAME} ==="
echo ""

# 1. Verify gh CLI is authenticated
echo "[1/6] Checking GitHub CLI authentication..."
if ! gh auth status >/dev/null 2>&1; then
    echo "ERROR: GitHub CLI not authenticated."
    echo "Run 'gh auth login' first, then re-run this script."
    exit 1
fi
echo "  OK - Authenticated as $(gh api user -q .login)"

# 2. Confirm repository details before creation
echo ""
echo "[2/6] Confirm repository details:"
echo ""
echo "  Repository : ${AUTHOR}/${PROJECT_NAME}"
echo "  Visibility : ${VISIBILITY}"
echo "  Description: ${DESCRIPTION}"
echo ""
read -rp "Change repository name? (Enter = keep '${PROJECT_NAME}', or type new name): " NEW_NAME
if [ -n "${NEW_NAME}" ]; then
    PROJECT_NAME="${NEW_NAME}"
    echo "  → Repository name changed to: ${AUTHOR}/${PROJECT_NAME}"
fi
echo ""
read -rp "Proceed with creation? (Y/n): " CONFIRM
if [[ "${CONFIRM}" =~ ^[Nn] ]]; then
    echo "Aborted."
    exit 0
fi

# 3. Create the repository on GitHub
echo ""
echo "[3/6] Creating repository ${AUTHOR}/${PROJECT_NAME} (${VISIBILITY})..."
if gh repo view "${AUTHOR}/${PROJECT_NAME}" >/dev/null 2>&1; then
    echo "  Repository already exists, skipping creation."
else
    gh repo create "${AUTHOR}/${PROJECT_NAME}" --"${VISIBILITY}" --description "${DESCRIPTION}"
    echo "  Repository created."
fi

# 4. Initialize git and set remote
echo ""
echo "[4/6] Initializing git repository..."
if [ -d .git ]; then
    echo "  Git already initialized, skipping."
else
    git init
    git remote add origin "https://github.com/${AUTHOR}/${PROJECT_NAME}.git"
    echo "  Git initialized with remote origin."
fi

# 5. Verify markdown (optional, non-blocking)
echo ""
echo "[5/6] Checking markdown files..."
if command -v npx >/dev/null 2>&1; then
    npx markdownlint-cli2 "**/*.md" && echo "  Markdown OK" || echo "  Warnings found (non-blocking)"
else
    echo "  npx not found, skipping markdown check."
fi

# 6. Commit and push
echo ""
echo "[6/6] Committing and pushing to GitHub..."
git add .
git commit -m "feat: initial scaffolding via GitHub Universal Scaffolding Generator"
git branch -M main
git push -u origin main

echo ""
echo "=== Done! ==="
echo ""
echo "Your repository is live at: https://github.com/${AUTHOR}/${PROJECT_NAME}"
echo ""
