#Requires -Version 7.0
#Requires -Modules @{ ModuleName="Pester"; ModuleVersion="5.0.0" }

<#
.SYNOPSIS
    Pester tests for {{ project_name }}

.DESCRIPTION
    Test suite using Pester 5.x framework
    Generated by GitHub Universal Scaffolding Generator
#>

BeforeAll {
    $modulePath = Join-Path $PSScriptRoot "{{ project_name }}.psm1"
    Import-Module $modulePath -Force
}

Describe "{{ project_name | replace('-', '') | title }}Function Tests" {
    Context "When calling with valid parameters" {
        It "Should return greeting message" {
            $result = Invoke-{{ project_name | replace('-', '') | title }}Function -Name "World"
            $result | Should -Be "Hello, World!"
        }

        It "Should accept pipeline input" {
            $result = "PowerShell" | Invoke-{{ project_name | replace('-', '') | title }}Function
            $result | Should -Be "Hello, PowerShell!"
        }
    }

    Context "When calling with invalid parameters" {
        It "Should throw when Name is empty" {
            { Invoke-{{ project_name | replace('-', '') | title }}Function -Name "" } | Should -Throw
        }

        It "Should throw when Name is null" {
            { Invoke-{{ project_name | replace('-', '') | title }}Function -Name $null } | Should -Throw
        }
    }
}

AfterAll {
    Remove-Module {{ project_name }} -Force -ErrorAction SilentlyContinue
}
