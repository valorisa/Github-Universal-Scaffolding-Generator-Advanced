version: 2
updates:
{% if "Python" in stack %}
  - package-ecosystem: "pip"
    directory: "/"
    schedule:
      interval: weekly
    open-pull-requests-limit: 10
{% elif "Node" in stack %}
  - package-ecosystem: "npm"
    directory: "/"
    schedule:
      interval: weekly
    open-pull-requests-limit: 10
{% elif "Go" in stack %}
  - package-ecosystem: "gomod"
    directory: "/"
    schedule:
      interval: weekly
    open-pull-requests-limit: 10
{% elif "Java" in stack %}
  - package-ecosystem: "maven"
    directory: "/"
    schedule:
      interval: weekly
    open-pull-requests-limit: 10
{% elif "Rust" in stack %}
  - package-ecosystem: "cargo"
    directory: "/"
    schedule:
      interval: weekly
    open-pull-requests-limit: 10
{% endif %}
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
